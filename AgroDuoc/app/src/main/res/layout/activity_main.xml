<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#1B2A1C"> <!-- Fondo verde oscuro agrícola -->

    <!-- Título de la Aplicación -->

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TecMundo\nConnect"
        android:gravity="center"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="@android:color/white" />

    <!-- Subtítulo / Eslogan didáctico -->

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="48dp"
        android:text="Conectando la producción agrícola\ncon servicios de aplicación"
        android:gravity="center"
        android:textSize="15sp"
        android:textColor="#A5D6A7" />

    <!-- Botón para Iniciar Sesión -->

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Iniciar Sesión"
        android:textSize="16sp"
        android:padding="12dp" />

    <!-- Botón para Crear Cuenta -->

    <Button
        android:id="@+id/btnRegister"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Crear una Cuenta"
        android:textSize="16sp"
        android:padding="12dp" />
</LinearLayout>